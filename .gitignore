# OS / editor
.DS_Store
*.swp
.vscode/
.claude/
.cursor/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
tmp/plot_venv/

# Large / regenerable local caches
tmp/
tmp_energy_search/

# Matplotlib / fontconfig junk
.cache/
.mplconfig/
.pycache/
.pycache_check/

# Nested git metadata
# (idea_a_mac nested repo removed)

# Large regenerable route-trace / raw CSVs
**/outputs/**/routes.csv
**/outputs/**/*_routes.csv
**/outputs/**/test_routes.csv
**/outputs/**/calibration_routes.csv
**/outputs/**/*_raw.csv
**/outputs/**/pair_interventions.csv
# Large, regenerable SemanticFence calibration traces.  Keep summary cards and
# manifests trackable; exclude only the high-volume raw call/numeric logs.
docs/ideas/semanticfence/experiments/outputs/semanticfence_pilot_*/calibration_calls.jsonl
docs/ideas/semanticfence/experiments/outputs/semanticfence_pilot_*/calibration_numeric.jsonl
docs/ideas/semanticfence/experiments/outputs/semanticfence_pilot_*/calibration_reference_rows.jsonl
docs/ideas/semanticfence/experiments/outputs/semanticfence_pilot_*/calibration_cublaslt_*.log
# Parent recomputation is represented by the compact raw-output index and
# hashes.  Keep the per-pair BF16 tensors local; together they exceed 1 GiB.
docs/ideas/semanticfence/experiments/outputs/semanticfence_pilot_*/evaluation_raw_bf16/
experiments/**/*.pt
experiments/**/*.safetensors
experiments/**/*.bin
docs/**/*.pt
docs/**/*.safetensors
**/checkpoints.jsonl

# Oversized raw ledgers retained locally.  Their compact summaries, manifests,
# recomputations, and audit cards remain trackable.
docs/ideas/spectatorroute/experiments/outputs/phase0a_5090_*/regime_cells.jsonl
docs/ideas/stablebatch/experiments/outputs/shape_lane_continuous_cost_*/expert_call_ledger.jsonl

# Raw experiment payloads remain local.  Compact JSON/Markdown summaries,
# manifests, hashes, and audit cards under the same run directories stay
# trackable and are committed separately.
docs/ideas/*/experiments/outputs/**/*.jsonl
docs/ideas/*/experiments/outputs/**/*.log
docs/ideas/*/experiments/outputs/**/*.log.gz
docs/ideas/*/experiments/outputs/**/*.exit
docs/ideas/*/experiments/outputs/**/frozen_inputs/*.py
docs/ideas/semanticfence/experiments/outputs/semanticfence_pilot_*/evaluation_arm_results.json

# Materialized vLLM runtime packages are local and represented in Git by their
# compact runtime-package manifests.
refine-logs/expert_saturation/outputs/native_route_shape/*/runtime/

# Resume / incomplete run leftovers
**/*.partial.csv
**/outputs/**/_smoke*/
**/outputs/**/*_smoke_*/

# Generated experiment bundles are local/external by default.  Keep only the
# repository policy and the canonical routing index in Git going forward.
/artifacts/**
!/artifacts/README.md
!/artifacts/index.json

