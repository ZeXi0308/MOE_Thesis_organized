{
  "status": "STRUCTURAL",
  "intervention_status": "NATIVE_GPU_UNRUN",
  "question": "Does the observed native baseline expose a pre-preemption state in which retained-KV completion-headroom protection can legally begin?",
  "formula": {
    "terminal_computed_tokens": "min(prompt_tokens + declared_max_output_tokens, max_model_len) - 1",
    "terminal_blocks": "ceil(terminal_computed_tokens / block_size)",
    "headroom": "max(0, terminal_blocks - allocated_blocks)",
    "next_allocation": "max(0, ceil((computed_tokens + 1) / block_size) - allocated_blocks)",
    "candidate": "minimum declared_max_output_tokens - current_output_tokens; native running order breaks ties",
    "first_pressure": "F - sum(next_allocation) < candidate_headroom - candidate_next_allocation",
    "activation_feasible": "F >= candidate_headroom"
  },
  "decision_inputs": [
    "current running request order",
    "current computed/output token counts",
    "current per-request allocated blocks",
    "current free blocks",
    "configured output cap and model context limit",
    "initialized block size"
  ],
  "excluded_decision_inputs": [
    "future route",
    "actual eventual completion time",
    "future preemption event",
    "future emitted token sequence"
  ],
