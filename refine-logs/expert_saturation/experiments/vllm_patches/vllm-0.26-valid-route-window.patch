+def test_routed_experts_capturer_clear_buffer_defaults_to_full_window():
+    capturer = _capturer_with_buffer(max_tokens=8, num_layers=4)
+    capturer.clear_buffer()
+    assert torch.count_nonzero(capturer.device_buffer).item() == 0
+
+
+def test_routed_experts_capturer_clear_buffer_only_visible_window():
+    """Dense/non-MoE layers in visible rows are zero; hidden tail may stay stale."""
+    capturer = _capturer_with_buffer(max_tokens=8, num_layers=4)
+    capturer.clear_buffer(num_tokens=3)
+
+    assert torch.count_nonzero(capturer.device_buffer[:3]).item() == 0
+    assert torch.all(capturer.device_buffer[3:] == -1)
+
+    # Simulate only layer 1 being an MoE layer. Dense layers in the exported
+    # window retain the zero sentinel established by clear_buffer().
+    capturer.device_buffer[:3, 1, :] = torch.tensor([[1, 2], [3, 4], [5, 6]])
+    assert torch.count_nonzero(capturer.device_buffer[:3, 0, :]).item() == 0
+    assert torch.count_nonzero(capturer.device_buffer[:3, 2:, :]).item() == 0
+
+
+def test_routed_experts_capturer_clear_buffer_handles_window_growth_and_shrink():
+    capturer = _capturer_with_buffer(max_tokens=8, num_layers=2)
+
+    capturer.clear_buffer(num_tokens=6)
+    capturer.device_buffer[:6].fill_(7)
+
+    # A smaller following step clears everything it can export. Stale rows are
+    # outside its output slice and therefore unobservable.
+    capturer.clear_buffer(num_tokens=2)
+    assert torch.count_nonzero(capturer.device_buffer[:2]).item() == 0
+    assert torch.all(capturer.device_buffer[2:6] == 7)
+
+    # If a later step grows again, the newly visible rows are cleared before
+    # forward/capture and cannot leak the old value.
+    capturer.clear_buffer(num_tokens=7)
+    assert torch.count_nonzero(capturer.device_buffer[:7]).item() == 0
+
+
+def test_routed_experts_capturer_clear_buffer_preserves_async_snapshot():
+    """The async path clones before the next step's default-stream clear."""
+    capturer = _capturer_with_buffer(max_tokens=8, num_layers=2)
+    capturer.clear_buffer(num_tokens=4)
+    capturer.device_buffer[:4].copy_(
+        torch.arange(16, dtype=torch.int32).reshape(4, 2, 2)
+    )
+    private_snapshot = capturer.device_buffer[:4].clone()
+
+    capturer.clear_buffer(num_tokens=2)
+    assert torch.equal(
+        private_snapshot, torch.arange(16, dtype=torch.int32).reshape(4, 2, 2)
+    )
+
+
+@pytest.mark.parametrize("num_tokens", [-1, 9])
+def test_routed_experts_capturer_clear_buffer_rejects_invalid_window(num_tokens):
+    capturer = _capturer_with_buffer(max_tokens=8)
+    with pytest.raises(ValueError, match="invalid routed-expert token window"):
+        capturer.clear_buffer(num_tokens=num_tokens)
