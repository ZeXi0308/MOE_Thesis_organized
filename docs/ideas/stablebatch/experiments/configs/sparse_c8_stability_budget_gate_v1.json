      "selector_harm_safe": "selector_net > 0 AND selector_recovered > selector_harmed",
      "selector_cross_document": "selector_positive_net_document_count >= 4 AND selector_above_cell_matched_random_rank_document_count >= 4"
    },
    "cases": {
      "HARM_DOMINATES": "Select first if recovered routes are nonzero and net utility is nonpositive for oracle_exact_B or for the ridge selector.",
      "ACTION_GENERALIZATION_FAIL": "Select if HARM_DOMINATES is false and action_generalizes is false.",
      "SELECTOR_AND_ACTION_GENERALIZE": "Select if action_generalizes, strong_rank_signal, selector_beats_global_random, selector_harm_safe, and selector_cross_document are all true.",
      "SELECTOR_WEAKLY_ABOVE_RANDOM": "Select if action_generalizes and rank_signal_positive are true, but one or more strong-rank, harm-safety, or cross-document conditions for SELECTOR_AND_ACTION_GENERALIZE are false.",
      "ACTION_GENERALIZES_SELECTOR_WEAK": "Select if action_generalizes is true and rank_signal_positive is false. Selector gain over global random alone is insufficient."
    }
