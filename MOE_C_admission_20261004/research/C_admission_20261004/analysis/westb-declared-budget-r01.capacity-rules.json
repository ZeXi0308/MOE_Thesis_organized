  "question": "Can fixed concurrency + actual free-KV rules reproduce all selected observed actions?",
  "rule": "native_fit && active < C && (free_blocks >= W || (age_bypass && age_s >= 10))",
  "parameter_domain": {
    "C": [
      1,
      256
    ],
    "W": [
      0,
      32768
    ],
    "integer_parameters": true
  },
  "method": "For each arm separately, Cmin=max(allow.active)+1; Wmax=min(allow.free_blocks), excluding age>=10 allows only in the bypass family. If no allow constrains W, Wmax=32768. This is the strictest combination preserving all allows. Any selected denial allowed by it rules out every parameter in that family; no grid search is used.",
  "selected_rows": "384 actual successful new local allocations per arm, with exact request-ID first-prefill host schedule-return timestamps at/after the decision; versus native-fit, baseline_allowed direct declared-budget denials. FIFO, native-fit failures, async loads and unvisited scan-break suffixes are excluded. baseline_allowed refers to cap256, not a fixed128 counterfactual.",
