      },
      {
        "line": 2659,
        "text": ""
      },
      {
        "line": 2660,
        "text": "        # If throughput mode is set, double max_num_batched_tokens and max_num_seqs."
      },
      {
        "line": 2661,
        "text": "        if self.performance_mode == \"throughput\":"
      },
