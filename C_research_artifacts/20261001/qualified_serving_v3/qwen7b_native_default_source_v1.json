      },
      {
        "line": 2666,
        "text": ""
      },
      {
        "line": 2667,
        "text": "        if orig_max_num_batched_tokens is None:"
      },
      {
        "line": 2668,
        "text": "            assert model_config.max_model_len is not None, ("
