        "text": "            # chunked MM input, a single multimodal item must fit in one batch."
      },
      {
        "line": 2680,
        "text": "            # Raise the floor to accommodate the largest per-item token count."
      },
      {
        "line": 2681,
        "text": "            if model_config.is_multimodal_model and model_config.is_mm_prefix_lm:"
      },
      {
        "line": 2682,
        "text": "                result = self._get_min_mm_batched_tokens(model_config)"
      },
      {
        "line": 2683,
        "text": "                if result is not None and result[0] > self.max_num_batched_tokens:"
      },
      {
        "line": 2684,
        "text": "                    mm_min, modality = result"
      },
      {
        "line": 2685,
        "text": "                    logger.info("
