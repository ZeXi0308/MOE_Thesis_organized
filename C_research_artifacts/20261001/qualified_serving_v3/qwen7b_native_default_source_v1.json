      },
      {
        "line": 48,
        "text": ""
      },
      {
        "line": 49,
        "text": "    max_num_batched_tokens: int = Field(default=DEFAULT_MAX_NUM_BATCHED_TOKENS, ge=1)"
      },
      {
        "line": 50,
        "text": "    \"\"\"Maximum number of tokens that can be processed in a single iteration."
