      {
        "line": 2692,
        "text": "                    )"
      },
      {
        "line": 2693,
        "text": "                    self.max_num_batched_tokens = mm_min"
      },
      {
        "line": 2694,
        "text": ""
      },
      {
        "line": 2695,
        "text": "            # When using default settings,"
      },
      {
        "line": 2696,
        "text": "            # Ensure max_num_batched_tokens does not exceed model limit."
      },
      {
        "line": 2697,
        "text": "            # Some models (e.g., Whisper) have embeddings tied to max length."
      },
      {
        "line": 2698,
        "text": "            self.max_num_batched_tokens = min("
      },
      {
        "line": 2699,
        "text": "                self.max_num_seqs * model_config.max_model_len,"
